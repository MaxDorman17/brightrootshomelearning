[Unit]
Description=Bright Roots Homeschool Backend (FastAPI/uvicorn)
After=network.target

[Service]
User=REPLACE_WITH_YOUR_USER
WorkingDirectory=/opt/brightrootshomelearning/backend
EnvironmentFile=/opt/brightrootshomelearning/backend/.env
ExecStart=/opt/brightrootshomelearning/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
